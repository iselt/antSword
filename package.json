{
  "name": "antsword",
  "version": "2.1.16",
  "description": "中国蚁剑是一款跨平台的开源网站管理工具",
  "main": "app.js",
  "private": true,
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@seald-io/nedb": "^4.1.2",
    "crypto-js": "^4.2.0",
    "extract-zip": "^2.0.1",
    "geoips": "^0.0.1",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "marked": "^18.0.2",
    "mime": "^4.1.0",
    "node-rsa": "^1.1.1",
    "proxy-agent": "^8.0.1",
    "superagent": "^10.3.0",
    "tar": "^7.5.13",
    "through": "^2.3.8",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2"
  },
  "scripts": {
    "start": "electron app.js",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:linux": "electron-builder --linux --x64 --arm64",
    "release": "electron-builder --mac --win --linux --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "author": "antoor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntSwordProject/antSword"
  },
  "build": {
    "appId": "org.antsword.app",
    "productName": "AntSword",
    "copyright": "Copyright © AntSword contributors",
    "asar": true,
    "files": [
      "app.js",
      "modules/**/*",
      "source/**/*",
      "static/**/*",
      "views/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development"
    },
    "afterPack": "./scripts/remove-update-meta.js"
  },
  "update": {
    "md5": "",
    "logs": "",
    "sources": {
      "github": "https://github.com/AntSwordProject/antSword/releases/latest"
    }
  },
  "bugs": {
    "url": "https://github.com/AntSwordProject/antSword/issues"
  },
  "homepage": "https://github.com/AntSwordProject/antSword/"
}
